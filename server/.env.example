PORT=4000
JWT_SECRET=cambiar-este-secreto-en-produccion
DOCTOR_USER=doctor
DOCTOR_PASSWORD=doctor123
ANTHROPIC_API_KEY=

# Mercado Pago (reserva pública de turnos con pago online).
# Mientras MP_ACCESS_TOKEN esté vacío, la reserva pública funciona sin pedir
# pago (modo de prueba): el turno queda confirmado directamente. Al cargar un
# access token real (de prueba o de producción) se activa el checkout de
# Mercado Pago automáticamente, sin tocar código.
MP_ACCESS_TOKEN=
# URL pública del FRONTEND (a donde Mercado Pago devuelve al paciente después de pagar)
APP_URL=http://localhost:5173
# URL pública de este BACKEND (a donde Mercado Pago envía la notificación de pago)
API_PUBLIC_URL=http://localhost:4000
